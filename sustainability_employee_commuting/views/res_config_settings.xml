<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sustainability.commuting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sustainability.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sustainability']/block[1]" position="after">
                <block title="Employee Commuting">
                    <setting
                        string="Emission factor"
                        help="Emission factor node applicable to employee commuting"
                    >
                        <field
                            name="employee_commuting_carbon_factor_id"
                            placeholder="Pick a emission factor"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Emission journal"
                        help="Emission journal applicable to employee commuting"
                    >
                        <field
                            name="employee_commuting_journal_id"
                            placeholder="Pick a journal"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Emission account"
                        help="Emission account applicable to employee commuting"
                    >
                        <field
                            name="employee_commuting_account_id"
                            placeholder="Pick an account"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Activate automatic computation"
                        help="Automatically compute employee commuting's CO2e every month"
                    >
                        <field name="employee_commuting_carbon_cronjob_active" />
                    </setting>
                    <setting
                        string="Activate auto post account move"
                        help="Automatically post each account generated by employee commuting cron"
                    >
                        <field name="employee_commuting_post_account_move_active" />
                    </setting>
                </block>
                <block title="Employee Remote Work">
                    <setting
                        string="Emission factor"
                        help="Emission factor applicable to employee remote work"
                    >
                        <field
                            name="employee_remote_work_carbon_factor_id"
                            placeholder="Pick a emission factor"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Emission journal"
                        help="Emission journal applicable to employee remote work"
                    >
                        <field
                            name="employee_remote_work_journal_id"
                            placeholder="Pick a journal"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Emission account"
                        help="Emission account applicable to employee remote work"
                    >
                        <field
                            name="employee_remote_work_account_id"
                            placeholder="Pick an account"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Activate automatic computation"
                        help="Automatically compute employee remote work's CO2e every month"
                    >
                        <field name="employee_remote_work_carbon_cronjob_active" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
