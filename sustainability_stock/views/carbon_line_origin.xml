<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="carbon_line_origin_tree_inherit" model="ir.ui.view">
            <field name="name">carbon.line.origin.tree.inherit</field>
            <field name="model">carbon.line.origin</field>
            <field name="inherit_id" ref="sustainability.carbon_line_origin_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_date']" position="before">
                    <field
                        optional="show"
                        name="move_carbon_freight_picking_id"
                        string="Stock Transfer"
                        widget="many2one"
                    />
                </xpath>
            </field>
        </record>

        <record id="carbon_line_origin_filter_inherit" model="ir.ui.view">
            <field name="name">carbon.line.origin.select.inherit</field>
            <field name="model">carbon.line.origin</field>
            <field name="inherit_id" ref="sustainability.carbon_line_origin_filter" />
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field
                        name="move_carbon_freight_picking_id"
                        string="Stock Transfer"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
