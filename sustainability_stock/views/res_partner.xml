<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_partner_form_freight" model="ir.ui.view">
            <field name="name">view_partner_form_freight</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="50" />
            <field name="arch" type="xml">
                <xpath
                    expr="//page[@name='sales_purchases']//group[@name='container_row_2']"
                    position="after"
                >
                    <group>
                        <group
                            string="CLimatiq API"
                            name="group_carbon_freight_settings"
                        >
                            <field
                                name="carbon_freight_transport_mode"
                                string="Transport mode"
                            />
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
