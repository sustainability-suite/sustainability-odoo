<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sustainability.inventory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sustainability.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sustainability']/block[1]" position="after">
                <block title="Inventory">
                    <setting
                        string="Climatiq API URL"
                        help="API URL for accessing Climatiq services."
                    >
                        <field name="carbon_freight_climatiq_api_url" />
                    </setting>
                    <setting
                        string="Climatiq API Key"
                        help="API key for accessing Climatiq services."
                    >
                        <field name="carbon_freight_climatiq_api_key" password="True" />
                    </setting>
                    <setting
                        string="Max deliveries to process"
                        help="Specify the maximum number of deliveries to process at once."
                    >
                        <field name="carbon_freight_max_delivery_count" />
                    </setting>
                    <setting
                        string="Default transport mode"
                        help="Select the default mode of transportation for freight orders."
                    >
                        <field name="carbon_freight_transport_mode" />
                    </setting>
                    <setting
                        string="Carbon Uncertainty Percentage"
                        help="Insert the uncertainty percentage related to freight emissions."
                    >
                        <field
                            name="carbon_freight_uncertainty_percentage"
                            widget="percentage"
                        />
                    </setting>
                    <setting
                        string="Tolerance (km)"
                        help="Maximum distance corrected to match a mixed transition point."
                    >
                        <field name="carbon_freight_tolerance" />
                    </setting>
                    <setting
                        string="Product for Upstream Freight"
                        help="Select the product for upstream freight transport."
                    >
                        <field
                            name="carbon_freight_product_upstream"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Product for Downstream Freight"
                        help="Select the product for downstream freight transport."
                    >
                        <field
                            name="carbon_freight_product_downstream"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Carbon freight journal"
                        help="Freight journal applicable to employee remote work"
                    >
                        <field
                            name="carbon_freight_journal_id"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Carbon freight account"
                        help="Freight account applicable to employee remote work"
                    >
                        <field
                            name="carbon_freight_account_id"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Carbon freight emission factor"
                        help="Emission factor applicable to freight"
                    >
                        <field
                            name="carbon_freight_carbon_factor_id"
                            options="{'no_create': True}"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
