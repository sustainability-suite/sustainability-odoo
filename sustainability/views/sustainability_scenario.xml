<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <data>
    <record id="sustainability_scenario_tree" model="ir.ui.view">
      <field name="name">sustainability.scenario.tree</field>
      <field name="model">sustainability.scenario</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name" />
          <field name="description" />
          <field name="end_date" />
        </tree>
      </field>
    </record>

    <record id="sustainability_scenario_filter" model="ir.ui.view">
      <field name="name">sustainability.scenario.select</field>
      <field name="model">sustainability.scenario</field>
      <field name="arch" type="xml">
        <search string="Search Scenarios">
          <separator />
          <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
        </search>
      </field>
    </record>

    <record id="sustainability_scenario_form" model="ir.ui.view">
      <field name="name">sustainability.scenario.form</field>
      <field name="model">sustainability.scenario</field>
      <field name="arch" type="xml">
        <form>
          <field name="active" invisible="1" />
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button
                                type="object"
                                name="action_see_action_plans"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                attrs="{'invisible': [('action_plan_qty', '&lt;', 1)]}"
                            >
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field
                                            name="action_plan_qty"
                                            nolabel="1"
                                            widget="statinfo"
                                        />
                                    </span>
                                    <span class="o_stat_text">Action Plans</span>
                                </div>
                            </button>
                            <button
                                class="oe_stat_button"
                                icon="fa-leaf"
                                name="action_see_actions"
                                type="object"
                                attrs="{'invisible': [('action_qty', '&lt;', 1)]}"
                            >
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field
                                            name="action_qty"
                                            nolabel="1"
                                            widget="statinfo"
                                        />
                                    </span>
                                    <span class="o_stat_text">Actions</span>
                                </div>
                            </button>
                        </div>
                        <widget
                            attrs="{'invisible': [('active', '=', True)]}"
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                        />
            <div class="oe_title">
              <label for="name" />
              <h1>
                <field name="name" />
              </h1>
            </div>
            <group>
              <field name="description" />
              <field name="end_date" />
            </group>
            <notebook>
              <page string="Action Plans" name="page_action_plans">
                <field name="action_plan_ids" colspan="2" nolabel="1">
                  <tree editable="bottom" />
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" />
            <field name="activity_ids" />
            <field name="message_ids" />
          </div>
        </form>
      </field>
    </record>

    <record id="sustainability_scenario_window_action" model="ir.actions.act_window">
      <field name="name">Scenarios</field>
      <field name="res_model">sustainability.scenario</field>
      <field name="type">ir.actions.act_window</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No scenarios yet !</p>
      </field>
    </record>
  </data>
</odoo>
