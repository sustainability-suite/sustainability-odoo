<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- IMPORTANT: explictly include col/row otherwise studio won't load report correctly -->
    <template id="report_producttemplatelabel2x7_carbon">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="2" />
                <t t-set="rows" t-value="7" />
                <t t-call="sustainability_product_label_print.report_productlabel_inherit" />
            </div>
        </t>
    </template>

    <template id="report_producttemplatelabel4x7_carbon">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="4" />
                <t t-set="rows" t-value="7" />
                <t t-call="sustainability_product_label_print.report_productlabel_inherit" />
            </div>
        </t>
    </template>

    <template id="report_producttemplatelabel4x12_carbon">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="4" />
                <t t-set="rows" t-value="12" />
                <t t-set="price_included" t-value="True" />
                <t t-call="sustainability_product_label_print.report_productlabel_inherit" />
            </div>
        </t>
    </template>

    <template id="report_producttemplatelabel4x12noprice_carbon">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="4" />
                <t t-set="rows" t-value="12" />
                <t t-set="price_included" t-value="False" />
                <t t-call="sustainability_product_label_print.report_productlabel_inherit" />
            </div>
        </t>
    </template>

    <template id="report_producttemplatelabel_dymo_carbon">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-call="sustainability_product_label_print.report_productlabel_inherit_dymo" />
            </div>
        </t>
    </template>
</odoo>
